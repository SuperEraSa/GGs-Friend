# Copy this file's variables into your hosting provider's Environment
# Variables settings (Vercel: Project Settings -> Environment Variables).
# Do not commit a real .env file with real values to any public repo.

# Required. Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional but recommended. If set, the app asks for this passcode before
# it lets anyone chat, so the public link can't be found and used by
# strangers, running up your API bill. Leave blank to disable the gate.
ACCESS_PASSCODE=
